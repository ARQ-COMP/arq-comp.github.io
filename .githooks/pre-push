#!/bin/sh
#
# Refuses a push if the site does not build.
#
# This stands in for CI: GitHub Pages builds on push and, if it fails, simply
# does not publish -- so without a check somewhere, a broken build is only
# noticeable by the site quietly going stale.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Bypass for one push:     git push --no-verify

set -e

echo "pre-push: building the site before it goes public..."

if ! command -v bundle >/dev/null 2>&1; then
    echo "pre-push: bundler not found -- skipping the build check." >&2
    echo "pre-push: see the README for local setup." >&2
    exit 0
fi

make check

echo "pre-push: OK"
